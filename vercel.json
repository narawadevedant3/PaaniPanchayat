{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd src/frontend && npm install && npm run build",
  "outputDirectory": "src/frontend/out",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    }
  ]
}
